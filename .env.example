# La única clave que hace falta, y es gratis.
# Se saca en https://aistudio.google.com/apikey
#
# Se usa para: transcribir con segunda opinión, elegir las mejores tomas,
# escuchar la música candidata y ubicar la cara para el encuadre.
GEMINI_API_KEY=

# Opcional: qué modelo de Gemini usar primero. Si queda vacío, el proyecto prueba
# gemini-pro-latest, después gemini-2.5-pro y, como último recurso, gemini-2.5-flash.
GEMINI_MODEL=

# Opcional: si ya tenés whisper.cpp 1.5 instalado en otra carpeta (con main y el modelo
# ggml-small.bin adentro), poné esa carpeta acá y no hace falta npm run whisper.
# Si queda vacío, Whisper se instala dentro del proyecto, en .whisper/.
WHISPER_DIR=
