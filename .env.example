# La única clave que hace falta, y es gratis.
# Se saca en https://aistudio.google.com/apikey
#
# Se usa para: transcribir con segunda opinión, elegir las mejores tomas,
# escuchar la música candidata y ubicar la cara para el encuadre.
GEMINI_API_KEY=

# Opcional: qué modelo de Gemini usar primero. Si queda vacío, el proyecto prueba
