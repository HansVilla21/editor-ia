node_modules/
out/

# Un bundle de Remotion por entrada (scripts/bundle-fijo.mjs): se rehace solo, no viaja en el repo
/build/
# El material de los videos ya publicados, fuera de public/ para que no se copie en cada bundle
/archivo-public/

# La clave de Gemini nunca se commitea
.env
.env.*
!.env.example

# Estado local de cada usuario
estado.json

# Whisper: el programa y el modelo se bajan con npm run whisper, no viajan en el repo
/.whisper/

# Lo de cada video (public/<slug>/) y los efectos, que se bajan de Mixkit
/public/*/

# Material de cada usuario: sus videos y sus referencias.
# Con la barra adelante: sin ella, también se ignoraba la carpeta del estilo neutro
# (.claude/skills/editar-video/referencias/), y el estilo nunca llegó al repo.
/videos/
/referencias/

CLAUDE.local.md
.DS_Store
Thumbs.db

# Lo que la persona escribe en memory/ es suyo: viajan el README y las plantillas, no las respuestas
/memory/*
!/memory/README.md
!/memory/plantillas/

# Lo de cada video (su composición, su transcripción y guia.png con la cara de la persona): viaja la plantilla
/src/*/
!/src/plantilla/
!/src/entries/
/src/entries/*
!/src/entries/plantilla.tsx
